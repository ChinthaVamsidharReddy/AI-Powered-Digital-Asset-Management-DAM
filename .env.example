# Copy to .env and adjust. No secrets are required by this project.

# Folder containing the media to index (scanned recursively)
MEDIA_DIR=./data/media
# Where the SQLite DB and thumbnails are stored
DATA_DIR=./data/index

# "clip" = real models (default). "fake" = tiny deterministic stand-in used by the tests
MODEL_BACKEND=clip
CLIP_MODEL=clip-ViT-B-32
TEXT_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Parallel file workers (I/O + decoding). Model inference itself is serialised.
WORKERS=4

# Video: at most VIDEO_MAX_FRAMES frames, at least VIDEO_MIN_INTERVAL seconds apart
VIDEO_MAX_FRAMES=24
VIDEO_MIN_INTERVAL=8
VIDEO_DEDUPE_THRESHOLD=0.97
VIDEO_TIME_BUDGET_SEC=180

# PDF: pages whose text is embedded / pages rendered to images for CLIP
PDF_MAX_TEXT_PAGES=300
PDF_MAX_RENDER_PAGES=8

# Optional speech transcription for videos (needs `pip install faster-whisper`)
ENABLE_ASR=false
ASR_MODEL=tiny.en

# Relevance control (cosine similarity). A hit must be above the FLOOR and within MARGIN of the best hit.
# Calibrate the floors on your data with:  python scripts/calibrate.py
CLIP_MIN_SCORE=0.20
TEXT_MIN_SCORE=0.30
CLIP_MARGIN=0.05
TEXT_MARGIN=0.10

HOST=127.0.0.1
PORT=8000
